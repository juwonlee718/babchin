# Supabase Dashboard > Project Settings > API에 표시되는 프로젝트 URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 브라우저에서 사용하는 Supabase Publishable key (레거시 프로젝트의 anon key도 사용 가능)
# service_role/secret key는 절대 넣지 마세요.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Kakao Developers > 앱 키의 JavaScript 키
NEXT_PUBLIC_KAKAO_MAP_KEY=your_kakao_javascript_key
